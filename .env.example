# 复制为 .env 后填写真实值（.env 已被 git 忽略，不会提交）
# 用法：. .\scripts\load-env.ps1 或直接由 scripts/dev-backend.ps1 加载

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=community_repair
DB_USERNAME=root
DB_PASSWORD=

# ---- JWT ----
# 至少 32 字节，生产环境务必替换
JWT_SECRET=change-me-to-a-random-string-with-at-least-32-bytes
JWT_EXPIRE_MINUTES=720

# ---- 服务端口 ----
SERVER_PORT=8080

# ---- DeepSeek（P6 使用，可留空） ----
DEEPSEEK_API_KEY=

# ---- 文件上传（P5 使用） ----
UPLOAD_DIR=./data/uploads
