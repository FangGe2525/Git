!.yarn/versions

# ---- Java / Maven ----
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
!.mvn/wrapper/*.jar
.mvn/timing.properties
dependency-reduced-pom.xml

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 构建产物 ----
dist/
build/
out/
*.min.js
*.map

# ---- 日志与缓存 ----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
tmp/
temp/

# ---- 环境与密钥 ----
.env
.env.*
!.env.example
*.pem
*.key
!*.pub
secrets.*
credentials.*

# ---- 数据库 ----
*.sqlite
*.sqlite3
*.db

# ---- 运行时数据 ----
data/
data/uploads/

# ---- 本地工具链（项目内免安装 JDK/Maven，不提交） ----
.tools/

